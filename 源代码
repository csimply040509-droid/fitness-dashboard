    ['米饭','1碗 150g',175,4],['白粥','1碗',130,3],['馒头','1个 100g',220,7],
    ['面条','1碗 200g',280,9],['全麦面包','1片 35g',80,4],['红薯','1个 150g',130,2],
    ['玉米','1根 200g',110,4],['饺子','10个',350,15],['包子','1个 100g',200,8],
    ['蛋炒饭','1份 400g',500,14],['燕麦','40g 干重',150,5],['小米粥','1碗',120,3],
    ['炒河粉','1份',550,15],['意面','1份 200g',320,11]
  ],
  '肉蛋豆': [
    ['鸡胸肉','100g',165,31],['鸡腿','1个 120g',180,22],['鸡翅','1个 50g',90,8],
    ['猪里脊','100g',155,20],['五花肉','100g',340,13],['牛排','100g',125,26],
    ['牛肉(瘦)','100g',106,20],['鸡蛋','1个 50g',70,6],['蛋白','1个',17,4],
    ['豆腐','100g',80,8],['三文鱼','100g',140,20],['虾','100g',100,20],
    ['金枪鱼','100g',100,22],['牛奶','250ml',150,8],['无糖豆浆','250ml',80,7],
    ['希腊酸奶','100g',60,10],['鸡米花','1份 100g',280,15]
  ],
  '蔬菜': [
    ['西兰花','100g',35,3],['菠菜','100g',25,3],['白菜','100g',20,1.5],
    ['黄瓜','100g',15,0.8],['番茄','100g',20,1],['土豆','100g',80,2],
    ['胡萝卜','100g',40,1],['生菜','100g',15,1.4],['蘑菇','100g',25,3],
    ['青椒','100g',25,1.4],['茄子','100g',25,1],['豆芽','100g',30,3]
  ],
  '外卖': [
    ['巨无霸','1个',550,25],['汉堡(普通)','1个',300,15],['炸鸡','1块',250,15],
    ['薯条','中份',340,4],['披萨','1片',250,12],['麻辣烫','1份 500g',600,25],
    ['黄焖鸡米饭','1份',650,35],['兰州拉面','1碗',450,20],['螺蛳粉','1碗',400,12],
    ['煎饼果子','1个',400,12],['肉夹馍','1个',400,18],['小笼包','8个',400,20],
    ['盖浇饭','1份',600,25],['沙县拌面','1份',450,14],['麻辣香锅','1份',700,30],
    ['火锅(清汤)','1餐',800,40],['寿司','6个',300,12],['烤肉','1餐',900,50]
  ],
  '饮品': [
    ['可乐','330ml',140,0],['无糖可乐','330ml',0,0],['全糖奶茶','500ml',350,3],
    ['半糖奶茶','500ml',250,3],['无糖奶茶','500ml',150,3],['美式咖啡','1杯',10,0],
    ['拿铁','中杯',150,8],['橙汁','250ml',110,2],['啤酒','330ml',140,1],
    ['矿泉水','500ml',0,0],['运动饮料','500ml',120,0],['柠檬水','500ml',20,0]
  ],
  '零食': [
    ['苹果','1个中等',95,0.5],['香蕉','1根',105,1.3],['橙子','1个',70,1.3],
    ['西瓜','1块 200g',60,1],['薯片','1包 70g',380,4],['巧克力','50g',270,3],
    ['坚果','30g',180,6],['酸奶(加糖)','100g',90,3],['饼干','2片',100,2],
    ['蛋糕','1块',300,4],['冰淇淋','1个',200,4],['珍珠','1份',100,1]
  ],
  '调料': [
    ['食用油','1勺 10g',90,0],['沙拉酱','1勺',100,0.3],['白砂糖','1勺',40,0],
    ['花生酱','1勺',95,4],['辣椒油','1勺',120,0],['芝麻酱','1勺',100,3]
