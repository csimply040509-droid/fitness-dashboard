};

function load() {
  try {
    const raw = localStorage.getItem(KEY);
    if (!raw) { localStorage.setItem(KEY, JSON.stringify(DEFAULT)); return JSON.parse(JSON.stringify(DEFAULT)); }
    return JSON.parse(raw);
  } catch(e) { return JSON.parse(JSON.stringify(DEFAULT)); }
}
function save(d) { localStorage.setItem(KEY, JSON.stringify(d)); }
let DATA = load();

function toast(msg) { const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),1700); }
function today() { return new Date().toISOString().slice(0,10); }
function dayDiff(d1,d2){ return Math.round((new Date(d1)-new Date(d2))/86400000); }

function switchTab(name){
  ['home','log','food','set'].forEach(n=>{
    document.getElementById('tab-'+n).classList.toggle('hidden', n!==name);
    document.getElementById('t-'+n).classList.toggle('active', n===name);
  });
  if(name==='log') renderLogList();
  if(name==='food') renderFood();
}

function predict(){
  const pts = DATA.logs.filter(l=>l.weight!=null).sort((a,b)=>a.date.localeCompare(b.date));
  if(pts.length<3) return {ok:false,n:pts.length};
  const base=new Date(pts[0].date);
  const xs=pts.map(p=>dayDiff(p.date,base)), ys=pts.map(p=>p.weight), n=xs.length;
  const mx=xs.reduce((a,b)=>a+b,0)/n, my=ys.reduce((a,b)=>a+b,0)/n;
  let num=0,den=0;
  for(let i=0;i<n;i++){ num+=(xs[i]-mx)*(ys[i]-my); den+=(xs[i]-mx)**2; }
  const slope = den===0?0:num/den, intercept = my-slope*mx;
  const latestW=ys[n-1], latestDay=xs[n-1];
  const weekly=slope*7, proj30=intercept+slope*(latestDay+30);
  let eta=null;
  const goal=DATA.profile.goal_weight;
  if(goal&&slope!==0){ const d=(goal-latestW)/slope; if(d>0) eta=d/7; }
  return {ok:true,n,weekly,proj30,eta,latestW,conf:n>=14?'高':n>=7?'中':'低',
          trend: weekly<-0.1?'下降':weekly>0.1?'上升':'持平'};
}

function advice(){
  const p=DATA.profile;
  const recent=DATA.logs.filter(l=>dayDiff(today(),l.date)<7);
  const cals=recent.map(l=>l.calories).filter(x=>x!=null);
  const pros=recent.map(l=>l.protein).filter(x=>x!=null);
  const avgCal=cals.length?cals.reduce((a,b)=>a+b,0)/cals.length:null;
  const avgPro=pros.length?pros.reduce((a,b)=>a+b,0)/pros.length:null;
  const ws=DATA.logs.filter(l=>l.weight!=null).sort((a,b)=>b.date.localeCompare(a.date));
  const latestW=ws.length?ws[0].weight:null;
  let tdee=null;
  if(latestW&&p.height_cm&&p.age&&p.sex){
    const bmr=10*latestW+6.25*p.height_cm-5*p.age+(p.sex==='male'?5:-161);
    tdee=Math.round(bmr*1.2);
  }
  const out=[];
  if(tdee&&avgCal){
    const diff=Math.round(avgCal-tdee);
    if(diff>200) out.push(`近 7 天日均摄入 <b>${Math.round(avgCal)} kcal</b>，高于估算消耗（${tdee} kcal）约 <b>${diff} kcal/天</b>。若减重，建议每日约 <b>${tdee-500} kcal</b>。`);
    else if(diff<-300) out.push(`近 7 天日均摄入 <b>${Math.round(avgCal)} kcal</b>，低于估算消耗（${tdee} kcal）约 <b>${-diff} kcal/天</b>。缺口偏大易反弹，建议至少 <b>${tdee-300} kcal</b>。`);
    else out.push(`近 7 天日均摄入 <b>${Math.round(avgCal)} kcal</b>，与估算消耗（${tdee} kcal）基本持平，属<b>维持期</b>。` +
      (p.goal_weight>latestW ? `你想<b>增重</b>，建议每日吃到 <b>${tdee+400} kcal</b>（消耗 +400 盈余）。` : `你想<b>减重</b>，建议每日 <b>${tdee-500} kcal</b>，每周约减 0.5 kg。`));
  } else if(!latestW) out.push('先在「记录」页填一条 <b>体重</b>，才能给出个性化建议。');
  else { const miss=[]; if(!p.height_cm) miss.push('身高'); if(!p.age) miss.push('年龄');
    out.push(`补齐 <b>${miss.join('、')}</b>（设置页）即可估算每日消耗。`); }

  if(latestW&&avgPro!=null){
    const tp=Math.round(latestW*1.6);
    if(avgPro<tp*0.8) out.push(`近 7 天日均蛋白质 <b>${Math.round(avgPro)} g</b>，低于建议 <b>${tp} g/天</b>（1.6 g/kg）。每餐加份鸡蛋/鸡胸/牛奶/豆腐。`);
    else if(avgPro<tp*1.5) out.push(`近 7 天日均蛋白质 <b>${Math.round(avgPro)} g</b>，接近建议 ${tp} g，保持 ✓`);
  }
  const nW=DATA.logs.filter(l=>l.weight!=null).length;
  if(nW<7) out.push(`目前只有 <b>${nW} 条</b>体重记录。建议每周称 3-5 次，数据越多预测越准。`);
  if(!DATA.logs.length) out.push('🌱 还没有记录。早上记体重，睡前记热量，坚持 7 天看趋势。');
  return {tdee,avgCal:avgCal?Math.round(avgCal):null,avgPro:avgPro?Math.round(avgPro):null,out};
}

function renderChart(){
  const pts=DATA.logs.filter(l=>l.weight!=null).sort((a,b)=>a.date.localeCompare(b.date));
  const box=document.getElementById('chart');
  if(pts.length<2){ box.innerHTML='<div class="empty">至少记录 2 天体重才显示趋势</div>'; return; }
  const W=340,H=165,pad=28;
  const ws=pts.map(p=>p.weight);
  let min=Math.min(...ws),max=Math.max(...ws);
  if(max-min<1){min-=0.5;max+=0.5;}else{min-=0.2;max+=0.2;}
  const x=i=>pad+i*(W-2*pad)/(pts.length-1);
  const y=w=>H-pad-(w-min)*(H-2*pad)/(max-min);
  const line=pts.map((p,i)=>`${i?'L':'M'}${x(i).toFixed(1)},${y(p.weight).toFixed(1)}`).join(' ');
  const area=line+` L${x(pts.length-1).toFixed(1)},${H-pad} L${x(0).toFixed(1)},${H-pad} Z`;
  let circles='',labels='';
  pts.forEach((p,i)=>{
    circles+=`<circle cx="${x(i).toFixed(1)}" cy="${y(p.weight).toFixed(1)}" r="3.2" fill="#fff" stroke="#000" stroke-width="1.8"/>`;
    if(i%Math.ceil(pts.length/5)===0||i===pts.length-1)
      labels+=`<text x="${x(i).toFixed(1)}" y="${H-8}" font-size="9" fill="#767676" text-anchor="middle">${p.date.slice(5)}</text>`;
  });
  const gl=DATA.profile.goal_weight;
  const gy=(gl>=min&&gl<=max)?`<line x1="${pad}" y1="${y(gl).toFixed(1)}" x2="${W-pad}" y2="${y(gl).toFixed(1)}" stroke="#000" stroke-width="1" stroke-dasharray="3,3" opacity=".45"/>
    <text x="${W-pad}" y="${(y(gl)-5).toFixed(1)}" font-size="9" fill="#000" text-anchor="end" opacity=".6">目标 ${gl}</text>`:'';
  box.innerHTML=`<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:100%">
    <defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#000" stop-opacity=".10"/><stop offset="100%" stop-color="#000" stop-opacity="0"/>
    </linearGradient></defs>
    <path d="${area}" fill="url(#g)"/>
    <path d="${line}" fill="none" stroke="#000" stroke-width="2.2" stroke-linejoin="round"/>
    ${gy}${circles}${labels}
    <text x="${pad}" y="13" font-size="9" fill="#767676">${max.toFixed(1)}</text>
    <text x="${pad}" y="${H-pad+4}" font-size="9" fill="#767676">${min.toFixed(1)}</text>
  </svg>`;
}

function renderFood(){
  const chips=document.getElementById('foodChips');
  const cats=Object.keys(FOODS);
  if(!chips.dataset.init){
    chips.innerHTML=cats.map((c,i)=>`<div class="chip${i===0?' active':''}" data-cat="${c}" onclick="pickCat('${c}')">${c}</div>`).join('');
    chips.dataset.init='1';
  }
  const active=chips.querySelector('.chip.active');
  const cat=active?active.dataset.cat:cats[0];
  const q=(document.getElementById('foodSearch').value||'').trim();
  let list=[];
  if(q){ Object.keys(FOODS).forEach(c=>FOODS[c].forEach(f=>{ if(f[0].includes(q)) list.push(f); })); }
  else list=FOODS[cat]||[];
  const el=document.getElementById('foodList');
  if(!list.length){ el.innerHTML='<div class="empty">没找到「'+q+'」</div>'; return; }
  el.innerHTML=list.map(f=>`<div class="food-item">
    <div><div class="food-name">${f[0]}</div><div class="food-meta">${f[1]} · 蛋白 ${f[3]}g</div></div>
    <div class="food-right">
      <div class="food-kcal">${f[2]}<small>kcal</small></div>
      <div class="food-add" onclick="addFood('${f[0]}',${f[2]},${f[3]})">+</div>
    </div></div>`).join('');
}

function pickCat(c){
  document.querySelectorAll('#foodChips .chip').forEach(el=>el.classList.toggle('active', el.dataset.cat===c));
  document.getElementById('foodSearch').value='';
  renderFood();
}

function addFood(name,kcal,pro){
  const d=today();
  let log=DATA.logs.find(l=>l.date===d);
  if(!log){ log={date:d}; DATA.logs.push(log); }
  log.calories=(log.calories||0)+kcal;
  log.protein=(log.protein||0)+pro;
  save(DATA); render();
  toast('已添加 '+name+' +'+kcal+' kcal');
}

function render(){
  const p=DATA.profile;
  const ws=DATA.logs.filter(l=>l.weight!=null).sort((a,b)=>b.date.localeCompare(a.date));
  const latestW=ws.length?ws[0].weight:null;
  document.getElementById('kpiWeight').textContent = latestW!=null?latestW.toFixed(1):'--';
  if(ws.length>=2){
    const d=ws[0].weight-ws[1].weight;
    document.getElementById('kpiWeightDelta').textContent=(d>=0?'+':'')+d.toFixed(2)+' kg 较上次';
  }
  const pr=predict();
  if(pr.ok){
    document.getElementById('trendTag').textContent=`${pr.trend} · 置信度${pr.conf}`;
    document.getElementById('insightWeekly').textContent=(pr.weekly>=0?'+':'')+pr.weekly.toFixed(2);
    document.getElementById('insight30d').textContent=pr.proj30.toFixed(1);
    document.getElementById('insightEta').textContent=pr.eta!=null?pr.eta.toFixed(1):'—';
  } else {
    document.getElementById('trendTag').textContent=`需 ${3-pr.n} 条`;
    ['insightWeekly','insight30d','insightEta'].forEach(i=>document.getElementById(i).textContent='--');
  }
  if(latestW!=null&&p.start_weight&&p.goal_weight){
    const total=p.goal_weight-p.start_weight, done=latestW-p.start_weight;
    const pct=total!==0?Math.max(0,Math.min(100,done/total*100)):0;
    document.getElementById('kpiProgress').textContent=pct.toFixed(1);
    document.getElementById('goalFill').style.width=pct+'%';
    document.getElementById('goalFrom').textContent=`起始 ${p.start_weight} kg`;
    document.getElementById('goalTo').textContent=`目标 ${p.goal_weight} kg`;
    document.getElementById('kpiGoalText').textContent=`还差 ${(p.goal_weight-latestW).toFixed(1)} kg`;
  }
  const ad=advice();
  document.getElementById('adviceBox').innerHTML=ad.out.length?ad.out.map(s=>`<div class="advice-item">${s}</div>`).join(''):'<div class="empty">继续记录，AI 会给建议</div>';
  document.getElementById('headerSub').textContent=ad.tdee?`每日消耗 ${ad.tdee} kcal · 摄入 ${ad.avgCal||'—'} kcal`:'体重 · 饮食 · AI 预测';

  const tl=DATA.logs.find(l=>l.date===today());
  document.getElementById('todayKcal').textContent=(tl&&tl.calories?tl.calories:0)+' kcal';
  if(ad.tdee) document.getElementById('targetKcal').textContent=(ad.tdee+400)+' kcal';

  renderChart(); renderLogList();
}

function renderLogList(){
  const list=DATA.logs.slice().sort((a,b)=>b.date.localeCompare(a.date));
  const el=document.getElementById('logList');
  if(!list.length){ el.innerHTML='<div class="empty">还没有记录</div>'; return; }
  el.innerHTML=list.map(l=>`<div class="log-item">
    <div><div class="log-date">${l.date}</div>
      <div class="log-sub">${l.calories?l.calories+' kcal':''}${l.protein?' · 蛋白 '+Math.round(l.protein)+'g':''}</div></div>
    <div style="display:flex;align-items:center;gap:10px">
      <span style="font-weight:500">${l.weight!=null?l.weight.toFixed(1)+' kg':'—'}</span>
      <span class="log-del" onclick="delLog('${l.date}')">删除</span>
    </div></div>`).join('');
}

function saveLog(){
  const date=document.getElementById('logDate').value||today();
  const w=parseFloat(document.getElementById('logWeight').value);
  const c=parseInt(document.getElementById('logCal').value);
  const pr=parseFloat(document.getElementById('logProtein').value);
  const cb=parseFloat(document.getElementById('logCarb').value);
  const ft=parseFloat(document.getElementById('logFat').value);
  if(isNaN(w)&&isNaN(c)&&isNaN(pr)){ toast('请至少填一项'); return; }
  let log=DATA.logs.find(l=>l.date===date);
  if(!log){ log={date}; DATA.logs.push(log); }
  if(!isNaN(w)) log.weight=w;
  if(!isNaN(c)) log.calories=c;
  if(!isNaN(pr)) log.protein=pr;
  if(!isNaN(cb)) log.carbs=cb;
  if(!isNaN(ft)) log.fat=ft;
  save(DATA); render();
  ['logWeight','logCal','logProtein','logCarb','logFat'].forEach(i=>document.getElementById(i).value='');
  toast('已保存 '+date);
}
function delLog(date){ if(!confirm('删除 '+date+' 的记录？')) return; DATA.logs=DATA.logs.filter(l=>l.date!==date); save(DATA); render(); toast('已删除'); }
function saveProfile(){
  const p=DATA.profile;
  p.start_weight=parseFloat(document.getElementById('setStart').value)||p.start_weight;
  p.goal_weight=parseFloat(document.getElementById('setGoal').value)||p.goal_weight;
  p.height_cm=parseFloat(document.getElementById('setHeight').value)||p.height_cm;
  p.age=parseInt(document.getElementById('setAge').value)||p.age;
  p.sex=document.getElementById('setSex').value;
  p.target_date=document.getElementById('setTarget').value||p.target_date;
  save(DATA); render(); toast('资料已保存');
}
function exportData(){
  const b=new Blob([JSON.stringify(DATA,null,2)],{type:'application/json'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(b);
  a.download='fitness-backup-'+today()+'.json'; a.click(); toast('已导出');
}
function importData(e){
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=ev=>{ try{ DATA=JSON.parse(ev.target.result); save(DATA); fillSettings(); render(); toast('导入成功'); }catch(err){ toast('文件格式错误'); } };
  r.readAsText(f);
}
function clearData(){ if(!confirm('确定清空所有记录？建议先导出备份。')) return; DATA={profile:DATA.profile,logs:[]}; save(DATA); render(); toast('已清空'); }
function fillSettings(){
  const p=DATA.profile;
  document.getElementById('setStart').value=p.start_weight??'';
  document.getElementById('setGoal').value=p.goal_weight??'';
  document.getElementById('setHeight').value=p.height_cm??'';
  document.getElementById('setAge').value=p.age??'';
  document.getElementById('setSex').value=p.sex??'male';
  document.getElementById('setTarget').value=p.target_date??'';
}
document.getElementById('logDate').value=today();
fillSettings(); render();
</script>
</body>
